-- Função para criar botões modernos centralizados
local function createModernButton(text, icon)
    local buttonContainer = Instance.new("Frame")
    buttonContainer.Name = "Btn_" .. text:gsub("[%s%-]", "")
    buttonContainer.Size = UDim2.new(0.95, 0, 0, 50)  -- Aumentado
    buttonContainer.BackgroundTransparency = 1
    buttonContainer.Parent = scrollFrame
    
    local button = Instance.new("TextButton")
    button.Name = "Button"
    button.Text = ""
    button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    button.BorderSizePixel = 0
    button.Size = UDim2.new(1, 0, 1, 0)
    button.AutoButtonColor = false
    button.Parent = buttonContainer
    
    -- Efeito de brilho ao hover
    local hoverEffect = Instance.new("Frame")
    hoverEffect.Name = "HoverEffect"
    hoverEffect.Size = UDim2.new(1, 0, 1, 0)
    hoverEffect.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    hoverEffect.BackgroundTransparency = 0.95
    hoverEffect.BorderSizePixel = 0
    hoverEffect.Visible = false
    hoverEffect.Parent = button
    
    -- Efeito de clique
    local clickEffect = Instance.new("Frame")
    clickEffect.Name = "ClickEffect"
    clickEffect.Size = UDim2.new(1, 0, 1, 0)
    clickEffect.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    clickEffect.BackgroundTransparency = 0.9
    clickEffect.BorderSizePixel = 0
    clickEffect.Visible = false
    clickEffect.Parent = button
    
    button.MouseEnter:Connect(function()
        hoverEffect.Visible = true
        button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end)
    
    button.MouseLeave:Connect(function()
        hoverEffect.Visible = false
        clickEffect.Visible = false
        button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    end)
    
    button.MouseButton1Down:Connect(function()
        clickEffect.Visible = true
    end)
    
    button.MouseButton1Up:Connect(function()
        clickEffect.Visible = false
    end)
    
    -- Ícone
    if icon then
        local iconLabel = Instance.new("TextLabel")
        iconLabel.Text = icon
        iconLabel.Font = Enum.Font.GothamBold
        iconLabel.TextSize = 20  -- Aumentado
        iconLabel.TextColor3 = Color3.fromRGB(220, 60, 60)
        iconLabel.BackgroundTransparency = 1
        iconLabel.Size = UDim2.new(0, 45, 1, 0)  -- Aumentado
        iconLabel.Position = UDim2.new(0, 15, 0, 0)
        iconLabel.TextXAlignment = Enum.TextXAlignment.Left
        iconLabel.Parent = button
    end
    
    -- Texto do botão
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "TextLabel"
    textLabel.Text = text
    textLabel.Font = Enum.Font.Gotham
    textLabel.TextSize = 15  -- Aumentado
    textLabel.TextColor3 = Color3.new(1, 1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.Size = UDim2.new(1, -70, 1, 0)  -- Ajustado
    textLabel.Position = UDim2.new(0, 65, 0, 0)  -- Ajustado
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = button
    
    -- Status
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "Status"
    statusLabel.Text = "OFF"
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 13  -- Aumentado
    statusLabel.TextColor3 = Color3.fromRGB(180, 50, 50)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Size = UDim2.new(0, 60, 1, 0)
    statusLabel.Position = UDim2.new(1, -75, 0, 0)  -- Ajustado
    statusLabel.TextXAlignment = Enum.TextXAlignment.Right
    statusLabel.Parent = button
    
    return buttonContainer, textLabel, statusLabel
end

