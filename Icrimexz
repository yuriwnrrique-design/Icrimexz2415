-- ESP
local highlights = {}
local hpBarsDrawings = {}

local function removeEsp(player)
    if highlights[player] and highlights[player].Parent then
        highlights[player]:Destroy()
    end
    highlights[player] = nil
    
    if hpBarsDrawings[player] then
        for _, obj in pairs(hpBarsDrawings[player]) do
            if obj.Remove then obj:Remove() end
        end
        hpBarsDrawings[player] = nil
    end
end

local function applyEsp(player)
    if player.Character and not highlights[player] and player ~= localPlayer then
        local highlight = Instance.new("Highlight")
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = Color3.fromRGB(255, 50, 50)
        highlight.OutlineColor = Color3.fromRGB(255, 80, 80)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.1
        highlight.Parent = player.Character
        highlights[player] = highlight
    end
    
    if not hpBarsDrawings[player] and player ~= localPlayer then
        local bg = Drawing.new("Square")
        bg.Size = Vector2.new(50, 7)
        bg.Color = Color3.fromRGB(30, 30, 30)
        bg.Filled = true
        bg.Transparency = 0.8
        bg.Visible = true

        local bar = Drawing.new("Square")
        bar.Size = Vector2.new(48, 5)
        bar.Color = Color3.fromRGB(255, 50, 50)
        bar.Filled = true
        bar.Transparency = 0.8
        bar.Visible = true

        hpBarsDrawings[player] = {background = bg, bar = bar}
    end
end

local function updateEsp()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            if isEspEnabled then
                applyEsp(player)
            else
                removeEsp(player)
            end
        end
    end
end

