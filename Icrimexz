-- ============================================
-- RENDER LOOP
-- ============================================
RunService.RenderStepped:Connect(function(dt)
    local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    fovCircle.Position = center
    
    -- FOV Rotation
    rotateAngle = rotateAngle + dt * ROTATE_SPEED
    if rotateAngle > math.pi * 2 then rotateAngle = rotateAngle - math.pi * 2 end
    for i, line in ipairs(fovBars) do
        local angle = rotateAngle + (2 * math.pi * (i-1)/barCount)
        local startVec = center + Vector2.new(
            math.cos(angle) * (FOV_RADIUS - 15),
            math.sin(angle) * (FOV_RADIUS - 15)
        )
        local endVec = center + Vector2.new(
            math.cos(angle) * (FOV_RADIUS + 15),
            math.sin(angle) * (FOV_RADIUS + 15)
        )
        line.From = startVec
        line.To = endVec
        line.Visible = isFOVEnabled
    end
    fovCircle.Visible = isFOVEnabled
    
    -- AIMBOT
    if isAimbotEnabled then
        if not currentTarget or not currentTarget.Parent then
            currentTarget = getClosestPlayerHeadWithinFOV()
        else
            local head = currentTarget
            local root = head.Parent:FindFirstChild("HumanoidRootPart")
            
            if root then
                local dist3d = (root.Position - camera.CFrame.Position).Magnitude
                local headPos, visible = camera:WorldToViewportPoint(head.Position)
                local headScreenPos = Vector2.new(headPos.X, headPos.Y)
                local dist2d = (headScreenPos - center).Magnitude
                
                if not visible or dist2d > FOV_RADIUS or dist3d > AIMBOT_LOCK_RANGE then
                    currentTarget = getClosestPlayerHeadWithinFOV()
                end
            else
                currentTarget = getClosestPlayerHeadWithinFOV()
            end
        end
        
        if currentTarget then
            local targetPosition = currentTarget.Position
            local currentCameraCFrame = camera.CFrame
            local targetCFrame = CFrame.new(currentCameraCFrame.Position, targetPosition)
            camera.CFrame = currentCameraCFrame:Lerp(targetCFrame, aimbotSmoothness)
        end
    else
        currentTarget = nil
    end
    
    -- ESP UPDATE
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            if isEspEnabled and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChildWhichIsA("Humanoid") then
                applyEsp(player)
                
                local head = player.Character.Head
                local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
                local hp, maxhp = humanoid.Health, humanoid.MaxHealth
                local headScreen, visible = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                
                if hpBarsDrawings[player] then
                    for _, obj in pairs(hpBarsDrawings[player]) do
                        obj.Visible = visible and hp > 0
                    end
                    
                    if visible then
                        hpBarsDrawings[player].background.Position = Vector2.new(headScreen.X - 25, headScreen.Y - 25)
                        local frac = math.clamp(hp/maxhp, 0, 1)
                        hpBarsDrawings[player].bar.Size = Vector2.new(48 * frac, 5)
                        hpBarsDrawings[player].bar.Position = Vector2.new(headScreen.X - 24, headScreen.Y - 24)
                        
                        if frac > 0.6 then
                            hpBarsDrawings[player].bar.Color = Color3.fromRGB(50, 220, 50)
                        elseif frac > 0.3 then
                            hpBarsDrawings[player].bar.Color = Color3.fromRGB(220, 220, 50)
                        else
                            hpBarsDrawings[player].bar.Color = Color3.fromRGB(220, 50, 50)
                        end
                    end
                end
            else
                removeEsp(player)
            end
        end
    end
end)

