-- QUICK TP
btnQuickTP.Button.MouseButton1Click:Connect(function()
    local target = currentTarget
    if not target then
        local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
        local closestRoot, closestDist = nil, math.huge
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local root = player.Character.HumanoidRootPart
                local rootPos, visible = camera:WorldToViewportPoint(root.Position)
                if visible then
                    local screenPos = Vector2.new(rootPos.X, rootPos.Y)
                    local dist2d = (screenPos - screenCenter).Magnitude
                    if dist2d < closestDist then
                        closestDist = dist2d
                        closestRoot = root
                    end
                end
            end
        end
        target = closestRoot
    end
    
    if target and target.Parent then
        local targetRoot = target:IsA("Part") and target or target.Parent:FindFirstChild("HumanoidRootPart")
        local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if targetRoot and localRoot then
            local teleportPos = targetRoot.Position - (targetRoot.CFrame.LookVector * 5)
            local tweenInfo = TweenInfo.new(TP_SPEED, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(localRoot, tweenInfo, {CFrame = CFrame.new(teleportPos)})
            tween:Play()
            
            quicktpStatus.Text = "DONE"
            quicktpStatus.TextColor3 = Color3.fromRGB(50, 180, 50)
            task.wait(0.5)
            quicktpStatus.Text = "READY"
            quicktpStatus.TextColor3 = Color3.fromRGB(180, 180, 50)
        end
    end
end)

